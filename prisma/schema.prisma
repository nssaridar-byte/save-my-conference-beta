datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  FREE
  PRO
  ADMIN
}

model User {
  id       String  @id @default(cuid())
  name     String
  email    String? @unique
  password String?
  role     Role    @default(FREE)

  subscription Subscription?
  usage        Usage?
  speeches     Speech[]
  files        File[]
  conferences  Conference[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripeId         String?   @unique
  status           String? // active, past_due, canceled
  currentPeriodEnd DateTime?
}

model Usage {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  speechesCount Int @default(0)
  quizzesCount  Int @default(0)
  debatesCount  Int @default(0)
  crisisCount   Int @default(0)
}

model Speech {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title    String
  content  String
  grade    String? // A-F
  feedback String?
  conferenceId String
  conference Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  time Int?
  topic String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model File {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  url      String
  isPublic Boolean @default(false)

  createdAt DateTime @default(now())
}

enum Status {
  Active
  Inactive
}

model Conference {
  id        String   @id @default(cuid())
  title     String
  status    Status
  date      DateTime
  location  String
  committee String
  country   String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  topic String
  speeches Speech[]
}
