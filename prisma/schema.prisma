generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String        @id @default(cuid())
  name             String
  email            String?       @unique
  password         String?
  role             Role          @default(FREE)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  theme            String?       @default("dark")
  layoutMode       String?       @default("adaptive")
  emailVerified    DateTime?
  verificationCode String?
  conferences      Conference[]
  files            File[]
  speeches         Speech[]
  quizes           Quiz[]
  subscription     Subscription?
  usage            Usage?
  tokenUsages     TokenUsage[]
  knownDevices    KnownDevice[]
}

model KnownDevice {
  id        String   @id @default(cuid())
  userId    String
  ip        String
  userAgent String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([ip, userAgent])
}

model TokenUsage {
  id               String   @id @default(cuid())
  userId           String
  feature          String   // e.g., "speech-analyze", "quiz-gen", "crisis-gen", "crisis-eval"
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  cost             Float    // Calculated cost in USD
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  stripeId         String?   @unique
  status           String?
  currentPeriodEnd DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Usage {
  id                 String    @id @default(cuid())
  userId             String    @unique
  speechesCount      Int       @default(0)
  quizzesCount       Int       @default(0)
  debatesCount       Int       @default(0)
  crisisCount        Int       @default(0)
  crisisLimitHitAt   DateTime?
  debatesLimitHitAt  DateTime?
  quizzesLimitHitAt  DateTime?
  speechesLimitHitAt DateTime?
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Speech {
  id           String     @id @default(cuid())
  userId       String
  title        String
  content      String
  grade        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  conferenceId String
  time         Int?
  topic        String
  feedback     Json?
  conference   Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model Quiz {
  id String @id @default(cuid())
  conferenceId String
  conference Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  questions Json?
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
model File {
  id        String   @id @default(cuid())
  userId    String
  name      String
  url       String
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conference {
  id        String   @id @default(cuid())
  title     String
  status    Status
  date      DateTime
  location  String
  committee String
  country   String
  authorId  String
  topic     String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  speeches  Speech[]
  quizes    Quiz[]
  crisis    Crisis[]
}
model Crisis {
  id String @id @default(cuid())
  conferenceId String
  conference Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  events Json?
  response String?
  createdAt DateTime @default(now())
}
enum Role {
  FREE
  PRO
  ADMIN
}

enum Status {
  Active
  Inactive
}
